SECRET_KEY=your-secret-key-here-change-this-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=43200

# Google OAuth (optional)
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# CORS / Frontend config
# Comma-separated list of allowed origins (e.g., https://rapihin.ai,https://staging.rapihin.ai)
ALLOWED_ORIGINS=
# Frontend dev port override (defaults to 5173)
FRONTEND_PORT=5173

# OpenAI (for AI proofreading)
# Get an API key from https://platform.openai.com/
OPENAI_API_KEY=
# Optional: override default model (gpt-4o-mini)
OPENAI_MODEL=
